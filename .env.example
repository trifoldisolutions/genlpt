PORT=3001
MONGO_URI=mongodb://localhost:27017/genlpt
# Signs the login cookie: a long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
# Behind a proxy that terminates HTTPS (most hosts): how many proxies, usually 1. Without it the login cookie isn't set.
TRUST_PROXY=
# Optional: on SIGTERM (each deploy), how long acronym runs get to end before they're cut off and not counted
# (default 25000). Keep it a few seconds under the host's own shutdown grace period. Railway: 55000, under the
# 60 s draining time set in the service's Settings → Deploy → Teardown.
SHUTDOWN_GRACE_MS=

# Public address of the app, for links in account emails (never taken from the request). Production: https://genlpt.com
# Leave empty in development: links then follow PORT, so they keep working when the port switcher changes it.
APP_URL=

# Account emails (verification, password reset) via Resend (https://resend.com/api-keys).
# A key with "Sending access" limited to the genlpt.com domain is enough. Empty: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="GenLPT <no-reply@genlpt.com>"
# Who gets the daily AI spend alerts (DAILY_SPEND in config/limits.js); several: comma-separated. Empty: every admin.
ALERT_EMAIL=
# Where Settings → Help center's contact form sends each message, with the sender's address as Reply-To; several:
# comma-separated. Empty: every admin. It needs an inbox you can reply from: genlpt.com's own mail goes to Resend
# Receiving, so support@genlpt.com only works here once that address has a real mailbox.
SUPPORT_INBOX=

# Bot check on signup and on a guest's Help center message: Cloudflare Turnstile (Cloudflare dashboard → Turnstile → Add widget: mode Managed, hostname genlpt.com).
# Both empty: no check, only rate limits. For local testing, Cloudflare's keys that always pass:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (or site 3x00000000000000000000FF: always asks for a click).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# LLM: OpenRouter (https://openrouter.ai/keys). The models offered, and their reasoning effort, are in config/models.js.
# One key per plan, each named after its OpenRouter key (genlpt-guest, genlpt-free, genlpt-paid), so OpenRouter shows
# each plan's spend and caps it with that key's credit limit. The guest key is required; a plan left empty uses it.
OPENROUTER_GENLPT_GUEST=
OPENROUTER_GENLPT_FREE=
OPENROUTER_GENLPT_PAID=
# Optional: output cap per call (default 4096) and parallel calls (default 6)
OPENROUTER_MAX_TOKENS=
OPENROUTER_CONCURRENCY=
# Per call; a reasoning model can take a minute or more, so keep this generous
LLM_TIMEOUT_MS=180000
