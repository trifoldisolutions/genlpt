PORT=3001
MONGO_URI=mongodb://localhost:27017/genlpt
# Signs the login cookie: a long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
# Behind a proxy that terminates HTTPS (most hosts): how many proxies, usually 1. Without it the login cookie isn't set.
TRUST_PROXY=

# Public address of the app, for links in account emails (never taken from the request). Production: https://genlpt.com
APP_URL=http://localhost:3001

# Account emails (verification, password reset) via Resend (https://resend.com/api-keys).
# A key with "Sending access" limited to the genlpt.com domain is enough. Empty: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="GenLPT <no-reply@genlpt.com>"

# LLM provider: "ollama" (local) or "openrouter" (hosted)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=huihui_ai/gemma-4-abliterated:12b

# OpenRouter (https://openrouter.ai/keys), used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# The model used (and the only one in the dropdown unless OPENROUTER_MODELS adds more)
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional: extra models to offer in the dropdown, comma-separated ids
OPENROUTER_MODELS=
# Optional: reasoning effort for models that think before answering: low (default), none, medium, high, or default
OPENROUTER_REASONING=
# Optional: output cap per call (default 4096) and parallel calls (default 6)
OPENROUTER_MAX_TOKENS=
OPENROUTER_CONCURRENCY=
# Cold model loads can take ~1 min; keep this generous
LLM_TIMEOUT_MS=180000
