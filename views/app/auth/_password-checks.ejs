<%#
  Under a new password field (signup, reset, settings → Account): its rules (config/limits.js), each ticked once met,
  then a strength bar once they all are, to guide. PasswordStrength.watch (public/js/password.js) drives it, and holds
  the form back with data-unmet's message while a rule isn't met; without it, the rules read as plain text (the server
  checks them). Labels by level: 1 weak, 2 fair, 3 good, 4 strong. hintId: its id, for the field's aria-describedby.
%>
<% const each = limits.PASSWORD_MIN_EACH; %>
<div id="<%= locals.hintId || 'password-hint' %>" data-password-checks data-each='<%- JSON.stringify(each) %>'
  data-labels='<%- JSON.stringify(["", "Weak", "Fair", "Good", "Strong"]) %>'
  data-unmet="Please meet every requirement listed under the password."
  class="mt-1.5 space-y-2">
  <%# No length rule: 3 of each kind makes 12 characters already %>
  <ul class="grid grid-cols-2 gap-x-3 gap-y-1 text-sm text-zinc-500">
    <% [
      ['lower', `${each.lower} lowercase letters`],
      ['upper', `${each.upper} uppercase letters`],
      ['digit', `${each.digit} numbers`],
      ['symbol', `${each.symbol} special characters`],
    ].forEach(([rule, text]) => { %>
    <li data-rule="<%= rule %>" <% if (rule === 'symbol') { %>title="Like ! ? # $ (spaces don't count)"<% } %> class="flex items-center gap-1.5">
      <iconify-icon icon="boxicons:circle" width="16" height="16" hidden aria-hidden="true"></iconify-icon>
      <span><%= text %></span>
      <%# How many so far, while on the way: "2/3" %>
      <span data-count hidden class="tabular-nums text-zinc-400"></span>
    </li>
    <% }) %>
  </ul>
  <div data-strength hidden class="flex items-center gap-3">
    <div class="grid flex-1 grid-cols-4 gap-1" aria-hidden="true">
      <span class="h-1 rounded-full bg-zinc-200"></span><span class="h-1 rounded-full bg-zinc-200"></span><span class="h-1 rounded-full bg-zinc-200"></span><span class="h-1 rounded-full bg-zinc-200"></span>
    </div>
    <span data-strength-label class="w-16 shrink-0 text-right text-sm font-medium" aria-live="polite"></span>
  </div>
  <p data-strength-tip hidden class="text-sm text-zinc-500">It meets the rules but is easy to guess: avoid common words, your name or email, and runs like abc, 123 or aaa.</p>
</div>
