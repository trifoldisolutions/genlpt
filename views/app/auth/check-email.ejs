<%# After any signup or "Send a new email": the same page whether or not the address has an account %>
<h1 class="text-2xl font-bold tracking-tight">Check your inbox</h1>
<% if (notice === 'resent') { %>
<p class="mt-2 text-base text-zinc-600">We've sent another email to <span class="font-medium text-zinc-900"><%= values.email %></span> with the next steps. Please allow a few minutes for it to arrive.</p>
<% } else { %>
<p class="mt-2 text-base text-zinc-600">Thanks for signing up. We've sent an email to <span class="font-medium text-zinc-900"><%= values.email %></span> with the next steps.</p>
<% } %>
<p class="mt-3 text-base text-zinc-600">If it doesn't arrive within a few minutes, please check your spam folder or request a new email.</p>

<form method="post" action="/app/signup/resend" data-busy class="mt-6 space-y-3">
  <%- include('_alert') %>
  <input type="hidden" name="email" value="<%= values.email %>">
  <input type="hidden" name="next" value="<%= next %>">
  <button type="submit" class="btn-ghost w-full justify-center border border-zinc-200 py-2.5 font-medium text-zinc-700">
    <iconify-icon icon="boxicons:envelope" width="18" height="18" aria-hidden="true"></iconify-icon>
    <span>Send a new email</span>
  </button>
</form>
<a href="/app/login" class="mt-5 self-center text-sm font-medium text-cerise-600 hover:text-cerise-700 hover:underline">Back to log in</a>
