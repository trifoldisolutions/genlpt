<%
  // Log in and Sign up: one form, two modes (tabs). ?next= follows the visitor from one tab to the other.
  const signup = screen === 'signup';
  const q = next === '/app' ? '' : `?next=${encodeURIComponent(next)}`;
%>
<h1 class="text-2xl font-bold tracking-tight"><%= signup ? 'Create your account' : 'Welcome back' %></h1>
<p class="mt-1 text-base text-zinc-500"><%= signup ? 'Keep your sessions and favorite acronyms in one place.' : 'Log in to pick up your sessions where you left them.' %></p>

<nav class="mt-6 grid grid-cols-2 gap-1 rounded-md bg-zinc-100 p-1" aria-label="Account">
  <% [['login', 'Log in'], ['signup', 'Sign up']].forEach(([m, label]) => { %>
  <a href="/app/<%= m %><%= q %>" <% if (m === screen) { %>aria-current="page"<% } %> class="rounded-sm px-2 py-1.5 text-center text-base font-medium text-zinc-600 hover:text-zinc-900 aria-[current=page]:bg-surface aria-[current=page]:text-zinc-900 aria-[current=page]:shadow-sm pointer-coarse:py-2.5"><%= label %></a>
  <% }) %>
</nav>

<% if (notice === 'unverified') { %>
<!-- Right password, unconfirmed email. Only whoever knows the password sees this, so it reveals nothing. -->
<div role="status" class="mt-5 rounded-md bg-sky-50 px-3 py-3 text-base text-sky-900">
  <p>Please confirm your email address before logging in. We sent a confirmation link to <span class="font-medium"><%= values.email %></span> when you signed up.</p>
  <form method="post" action="/app/signup/resend" data-busy class="mt-3">
    <input type="hidden" name="email" value="<%= values.email %>">
    <input type="hidden" name="next" value="<%= next %>">
    <button type="submit" class="btn-ghost border border-sky-200 bg-surface px-3 py-2 font-medium text-sky-900">
      <iconify-icon icon="boxicons:envelope" width="18" height="18" aria-hidden="true"></iconify-icon>
      <span>Send a new link</span>
    </button>
  </form>
</div>
<% } %>

<form method="post" action="/app/<%= screen %>" data-busy class="mt-5 space-y-3">
  <input type="hidden" name="next" value="<%= next %>">
  <%- include('_alert') %>
  <% if (signup) { %>
  <label class="block">
    <span class="label">Name</span>
    <input type="text" name="name" value="<%= values.name || '' %>" autocomplete="name" maxlength="80" required class="field mt-1">
  </label>
  <% } %>
  <label class="block">
    <span class="label">Email</span>
    <input type="email" name="email" value="<%= values.email || '' %>" autocomplete="email" maxlength="254" required class="field mt-1">
  </label>
  <div>
    <div class="flex items-baseline justify-between gap-3">
      <label for="password" class="label">Password</label>
      <% if (!signup) { %>
      <a href="/app/forgot" data-forgot class="text-sm font-medium text-cerise-600 hover:text-cerise-700 hover:underline">Forgot password?</a>
      <% } %>
    </div>
    <div class="relative mt-1">
      <input type="password" id="password" name="password" autocomplete="<%= signup ? 'new-password' : 'current-password' %>" <% if (signup) { %>aria-describedby="password-hint"<% } %> maxlength="<%= limits.PASSWORD_MAX_CHARS %>" required class="field pr-11">
      <button type="button" data-reveal aria-controls="password" aria-label="Show password" title="Show password" class="icon-btn absolute right-0 top-1/2 -translate-y-1/2">
        <iconify-icon icon="boxicons:eye" width="20" height="20" aria-hidden="true"></iconify-icon>
      </button>
    </div>
    <% if (signup) { %><%- include('_password-checks') %><% } %>
  </div>
  <% if (signup && turnstileSiteKey) { %>
  <%# Bot check (Cloudflare Turnstile, services/turnstile.js): it shows itself only when it needs a click; auth.js holds an early submit %>
  <div data-turnstile class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="light" data-size="flexible" data-appearance="interaction-only" data-callback="turnstileDone"></div>
  <p data-turnstile-note role="status" hidden class="text-sm text-zinc-500">One moment: a quick security check is still running. If a checkbox appears above, please select it.</p>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
  <button type="submit" class="btn-primary !mt-5 w-full">
    <span><%= signup ? 'Create account' : 'Log in' %></span>
  </button>
  <% if (signup) { %>
  <p class="text-center text-sm text-zinc-500">We'll send you an email to confirm your address.</p>
  <% } %>
</form>

<div class="my-5 flex items-center gap-3 text-sm text-zinc-400" aria-hidden="true">
  <span class="h-px flex-1 bg-zinc-200"></span>or<span class="h-px flex-1 bg-zinc-200"></span>
</div>
<div class="flex flex-col gap-2.5">
  <%# Not built yet: auth.js only shows the note below %>
  <button type="button" data-google aria-describedby="google-note" class="btn-ghost w-full justify-center border border-zinc-200 py-2.5 font-medium text-zinc-700">
    <%# Google's own "G" (its sign-in branding asks for this mark, in these colors) %>
    <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
    </svg>
    <span>Continue with Google</span>
  </button>
  <a href="<%= next %>" class="btn-ghost w-full justify-center border border-zinc-200 py-2.5 font-medium text-zinc-700">
    Continue as guest
  </a>
</div>
<p id="google-note" role="status" hidden class="mt-3 text-center text-sm text-zinc-500">Continuing with Google isn't available yet. Please use your email address, or continue as a guest.</p>
