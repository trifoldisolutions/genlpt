<%- include('partials/head') %>
<h1 class="text-3xl font-bold">Admin</h1>
<ul class="mt-6 max-w-md divide-y divide-zinc-100 overflow-hidden rounded-md border border-zinc-200 bg-surface">
  <li>
    <a href="/admin/mail" class="flex items-center gap-3 px-4 py-3 -outline-offset-2 hover:bg-zinc-50">
      <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-500" aria-hidden="true">
        <iconify-icon icon="boxicons:envelope" width="18" height="18"></iconify-icon>
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-base font-medium text-zinc-800">Mail</span>
        <span class="block text-sm text-zinc-500">Read and answer what’s sent to the team’s addresses.</span>
      </span>
      <% if (unread?.all) { %><span class="rounded-full bg-brand px-2 py-0.5 text-xs font-semibold text-on-brand"><%= unread.all %> unread</span><% } %>
    </a>
  </li>
</ul>
<%- include('partials/foot') %>
