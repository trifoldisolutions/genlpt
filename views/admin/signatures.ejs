<%- include('partials/head') %>
<%# What goes under what's written, one for each mailbox (routes/admin.js, services/mail.js). Plain text: the email's design does the rest. %>
<% toasts.forEach((note) => { %>
<template data-flash="<%= note.kind %>"><%= note.text %></template>
<% }) %>
<div class="max-w-2xl">
  <a href="/mail" class="btn-ghost -ml-2">
    <iconify-icon icon="boxicons:arrow-left" width="18" height="18" aria-hidden="true"></iconify-icon>
    <span>Back to mail</span>
  </a>
  <h1 class="mt-3 text-3xl font-bold tracking-tight">Signatures</h1>
  <p class="mt-2 text-zinc-600">Each one goes under what you write, on every email sent from that address. Leave one empty to send without a signature.</p>

  <form method="post" action="/mail/signatures" data-busy class="mt-6 space-y-5">
    <% if (error) { %>
    <p role="alert" class="rounded-md bg-red-50 px-3 py-2 text-base text-red-800"><%= error %></p>
    <% } %>
    <% mailboxes.forEach((m) => { %>
    <label class="block">
      <span class="label"><%= m.name %> <span class="font-normal text-zinc-500"><%= m.address %></span></span>
      <textarea name="<%= m.field %>" rows="3" maxlength="<%= signatureMax %>" class="field mt-1 resize-y"><%= m.text %></textarea>
    </label>
    <% }) %>
    <div class="flex justify-end">
      <button type="submit" class="btn-primary py-2">
        <iconify-icon icon="boxicons:check" width="18" height="18" aria-hidden="true"></iconify-icon>
        <span>Save</span>
      </button>
    </div>
  </form>
</div>
<%- include('partials/foot') %>
