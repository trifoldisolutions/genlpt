<%
  // What narrows the list, opened from the search field (head.ejs). It's inside the search's form, so that a search keeps
  // the filter and the filter keeps what's typed in the search. A popover: the browser closes it on a click outside or
  // Esc, and public/js/admin.js puts it under its button.
  const filter = search.filter;
%>
<div id="mail-filter" popover data-menu="right" class="inset-auto m-0 w-80 max-w-[calc(100vw-2rem)] rounded-md border border-zinc-200 bg-surface p-3 text-zinc-700 shadow-lg">
  <div class="flex flex-col gap-3">
    <label class="flex cursor-pointer items-center gap-2 text-base text-zinc-700">
      <input type="checkbox" name="unread" value="1" <% if (filter.unreadOnly) { %>checked<% } %> class="size-4 shrink-0 accent-brand">
      <span>Unread only</span>
    </label>
    <label class="block">
      <span class="label">Written by</span>
      <input type="text" name="author" value="<%= filter.author %>" maxlength="<%= search.maxLength %>" autocomplete="off" spellcheck="false" placeholder="A name or an address" class="field mt-1">
    </label>
    <label class="block">
      <span class="label">Sent to</span>
      <input type="text" name="recipient" value="<%= filter.recipient %>" maxlength="<%= search.maxLength %>" autocomplete="off" spellcheck="false" placeholder="An address" class="field mt-1">
    </label>
    <div class="grid grid-cols-2 gap-2">
      <%# The script puts a calendar of the app's own over each (public/js/date-field.js), and keeps the date in them %>
      <div class="min-w-0">
        <label for="mail-since" class="label">From date</label>
        <div class="mt-1"><input id="mail-since" type="date" name="since" value="<%= filter.since %>" class="field"></div>
      </div>
      <div class="min-w-0">
        <label for="mail-until" class="label">To date</label>
        <div class="mt-1"><input id="mail-until" type="date" name="until" value="<%= filter.until %>" class="field"></div>
      </div>
    </div>
    <div class="flex justify-end gap-2 border-t border-zinc-200 pt-3">
      <% if (filter.on) { %><a href="<%= clearFilters %>" class="btn-ghost border border-zinc-200 px-3 py-2 font-medium text-zinc-700">Clear</a><% } %>
      <button type="submit" class="btn-primary border border-transparent py-2">Apply</button>
    </div>
  </div>
</div>
