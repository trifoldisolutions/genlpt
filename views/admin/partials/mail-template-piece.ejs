<%# The opening or closing chosen in the message box (views/admin/mail.ejs, public/js/mail-templates.js), apart from the message it frames: it goes out with it, a blank line apart (services/mail.js). The × takes it off. edge: the border between it and the message. %>
<div id="mail-<%= kind %>" <% if (!text) { %>hidden<% } %> class="flex shrink-0 items-start gap-2 <%= edge %> border-zinc-200 bg-zinc-50 py-2 pr-1.5 pl-3">
  <div class="min-w-0 flex-1">
    <span class="block text-xs font-medium text-zinc-500"><%= label %></span>
    <p data-text class="mt-0.5 whitespace-pre-line break-words text-zinc-900"><%= text %></p>
  </div>
  <button type="button" data-remove class="icon-btn size-7 pointer-coarse:size-10" aria-label="Remove the <%= label.toLowerCase() %>" title="Remove the <%= label.toLowerCase() %>">
    <iconify-icon icon="boxicons:x" width="16" height="16" aria-hidden="true"></iconify-icon>
  </button>
</div>
