<%
  // Every admin page, apart from the public site and the app: its own header, its own theme (System, Light or Dark,
  // kept under admin.theme, public/js/theme.js and admin.js), no public links or footer. Signed out (the sign-in page):
  // no header. nav: the section open, for its link. fill: a page that fills the window and scrolls inside itself (Mail).
  // search: the page's search bar, in the header (its own row on a phone, where phone says whether it shows at all).
  const signedIn = !!locals.admin;
  const fill = !!locals.fill;
  const sections = [{ key: 'mail', label: 'Internal Mail Services', href: '/mail' }];
  const themes = [
    { value: 'system', label: 'System', icon: 'desktop' },
    { value: 'light', label: 'Light', icon: 'sun' },
    { value: 'dark', label: 'Dark', icon: 'moon' },
  ];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title><%= locals.title ? `${title} · ${appName} Admin` : `${appName} Admin` %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=SUSE:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/output.css">
  <script src="/js/theme.js" data-key="admin.theme" data-themes="system light dark"></script>
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@2/dist/iconify-icon.min.js"></script>
</head>
<body class="<%= fill ? 'flex h-dvh flex-col overflow-hidden' : 'min-h-dvh' %> bg-zinc-50 font-sans text-zinc-900 antialiased">
<% if (signedIn) { %>
  <header class="shrink-0 border-b border-zinc-200 bg-surface">
    <div class="<%= fill ? '' : 'mx-auto max-w-6xl' %> flex flex-wrap items-center justify-between gap-x-3 gap-y-2 px-4 py-2 lg:gap-x-6">
      <div class="flex items-center gap-3 lg:gap-6">
        <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
          <span><%= appName %></span>
          <span class="hidden rounded-sm bg-zinc-900 px-1.5 py-0.5 text-xs font-semibold tracking-wide text-zinc-50 sm:inline">ADMIN</span>
        </a>
        <nav aria-label="Admin" class="flex gap-1">
          <% sections.forEach((s) => { %>
          <a href="<%= s.href %>" <% if (locals.nav === s.key) { %>aria-current="page"<% } %> class="rounded-md px-2 py-1.5 text-sm text-zinc-600 sm:px-2.5 sm:text-base hover:bg-zinc-100 hover:text-zinc-900 aria-[current=page]:bg-zinc-100 aria-[current=page]:font-medium aria-[current=page]:text-zinc-900"><%= s.label %></a>
          <% }) %>
        </nav>
      </div>
      <% if (locals.search) { %>
      <form method="get" action="<%= search.action %>" role="search" class="<%= search.phone ? '' : 'hidden md:block' %> order-last w-full md:order-none md:w-auto md:max-w-md md:min-w-48 md:flex-1">
        <% Object.entries(search.hidden).forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>"><% }) %>
        <div class="relative">
          <iconify-icon icon="boxicons:search" width="18" height="18" class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-zinc-500" aria-hidden="true"></iconify-icon>
          <input type="search" name="q" value="<%= search.value %>" maxlength="<%= search.maxLength %>" placeholder="<%= search.label %>" aria-label="<%= search.label %>" autocomplete="off" enterkeyhint="search" class="field pr-10 pl-9 [&::-webkit-search-cancel-button]:appearance-none">
          <% if (search.value) { %>
          <a href="<%= search.clear %>" class="absolute top-1/2 right-1 inline-flex size-8 -translate-y-1/2 items-center justify-center rounded-md text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900" aria-label="Clear search" title="Clear search">
            <iconify-icon icon="boxicons:x" width="18" height="18" aria-hidden="true"></iconify-icon>
          </a>
          <% } %>
        </div>
      </form>
      <% } %>
      <%# Who's signed in, and the menu it opens. A popover: the browser closes it on a click outside or Esc. public/js/admin.js puts it under the button and runs the theme. %>
      <button type="button" popovertarget="admin-menu" class="flex items-center gap-2 rounded-md p-1 text-left hover:bg-zinc-100 sm:pr-2">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-cerise-50 text-sm font-semibold text-cerise-700" aria-hidden="true"><%= admin.initials %></span>
        <span class="sr-only sm:not-sr-only">
          <span class="block max-w-32 truncate font-medium text-zinc-900 lg:max-w-48"><%= admin.name %></span>
          <span class="block max-w-32 truncate text-sm text-zinc-500 lg:max-w-48"><%= admin.role %></span>
        </span>
        <iconify-icon icon="boxicons:chevron-down" width="18" height="18" class="text-zinc-500" aria-hidden="true"></iconify-icon>
      </button>
      <div id="admin-menu" popover class="inset-auto m-0 w-72 max-w-[calc(100vw-2rem)] rounded-md border border-zinc-200 bg-surface p-1.5 text-zinc-700 shadow-lg">
        <div class="flex items-center gap-3 p-2">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-cerise-50 font-semibold text-cerise-700" aria-hidden="true"><%= admin.initials %></span>
          <div class="min-w-0">
            <p class="font-semibold break-words text-zinc-900"><%= admin.name %></p>
            <p class="text-sm break-words text-zinc-500"><%= admin.role %></p>
            <p class="text-sm break-all text-zinc-500"><%= admin.email %></p>
          </div>
        </div>
        <div class="mt-1 border-t border-zinc-200 p-2">
          <fieldset>
            <legend class="text-sm text-zinc-500">Theme</legend>
            <div class="mt-1.5 grid grid-cols-3 gap-1">
              <% themes.forEach((theme) => { %>
              <label class="flex cursor-pointer flex-col items-center gap-1 rounded-md border border-zinc-200 px-1 py-2 text-sm hover:border-zinc-300 has-checked:border-cerise-500 has-checked:bg-cerise-50 has-checked:text-cerise-700 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-cerise-500">
                <input type="radio" name="admin-theme" value="<%= theme.value %>" class="sr-only">
                <iconify-icon icon="boxicons:<%= theme.icon %>" width="18" height="18" aria-hidden="true"></iconify-icon>
                <span><%= theme.label %></span>
              </label>
              <% }) %>
            </div>
          </fieldset>
        </div>
        <form method="post" action="/logout" class="mt-1 border-t border-zinc-200 pt-1">
          <button type="submit" class="btn-ghost w-full">
            <iconify-icon icon="boxicons:arrow-out-right-square-half" width="18" height="18" aria-hidden="true"></iconify-icon>
            <span>Sign out</span>
          </button>
        </form>
      </div>
    </div>
  </header>
<% } %>
  <main class="<%= fill ? 'min-h-0 flex-1' : 'mx-auto max-w-6xl px-4 py-8' %>">
