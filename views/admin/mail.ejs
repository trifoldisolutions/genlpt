<%- include('partials/head') %>
<%
  // The team's mailbox (routes/admin.js): folders on the side; beside them a folder's threads, one thread with its
  // reply form, or a new email. No script: links and forms only.
  const href = (params) => '/admin/mail?' + new URLSearchParams({ box: box.key, ...params });
  const who = (a) => (a?.name ? a.name : a?.address) || 'Unknown sender';
  const size = (n) => (n >= 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round((n || 0) / 1024))} KB`);
  const mailboxLabel = (address) => mail.BOXES.find((b) => b.address === address)?.label || 'Other';
%>
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold tracking-tight">Mail</h1>
  <div class="flex flex-wrap gap-2">
    <form method="post" action="/admin/mail/sync">
      <input type="hidden" name="box" value="<%= box.key %>">
      <button type="submit" class="btn-ghost border border-zinc-200 bg-surface px-3 py-2 font-medium text-zinc-700">
        <iconify-icon icon="boxicons:refresh-cw" width="18" height="18" aria-hidden="true"></iconify-icon>
        <span>Check for mail</span>
      </button>
    </form>
    <a href="<%= href({ compose: '1' }) %>" class="btn-primary py-2">
      <iconify-icon icon="boxicons:edit" width="18" height="18" aria-hidden="true"></iconify-icon>
      <span>New email</span>
    </a>
  </div>
</div>

<%# What the server has to say (sent, new mail, a failed check): toasts, like the app's (public/js/flash.js) %>
<% toasts.forEach((note) => { %>
<template data-flash="<%= note.kind %>"><%= note.text %></template>
<% }) %>

<div class="mt-6 grid gap-6 md:grid-cols-[11rem_minmax(0,1fr)]">

  <!-- Folders: a row that scrolls on small screens, a column beside the mail from md -->
  <nav aria-label="Folders" class="-mx-1 flex gap-1 overflow-x-auto px-1 md:mx-0 md:flex-col md:overflow-visible md:px-0">
    <% boxes.forEach((b) => { const current = b.key === box.key && !opened && !compose; %>
    <a href="/admin/mail?box=<%= b.key %>" <% if (current) { %>aria-current="page"<% } %> class="flex shrink-0 items-center justify-between gap-3 rounded-md px-3 py-2 text-base text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900 aria-[current=page]:bg-zinc-100 aria-[current=page]:font-medium aria-[current=page]:text-zinc-900">
      <span><%= b.label %></span>
      <% if (counts[b.key]) { %><span class="rounded-full bg-brand px-1.5 text-xs font-semibold text-on-brand"><%= counts[b.key] %><span class="sr-only"> unread</span></span><% } %>
    </a>
    <% }) %>
  </nav>

  <section class="min-w-0">
  <% if (opened) { const { thread, messages } = opened; %>
    <!-- One thread, oldest first, then the reply form -->
    <div class="flex flex-wrap items-center justify-between gap-2">
      <a href="/admin/mail?box=<%= box.key %>" class="btn-ghost -ml-2">
        <iconify-icon icon="boxicons:chevron-left" width="18" height="18" aria-hidden="true"></iconify-icon>
        <span><%= box.label %></span>
      </a>
      <% if (messages.some((m) => m.direction === 'in')) { %>
      <form method="post" action="/admin/mail/threads/<%= thread._id %>/unread">
        <input type="hidden" name="box" value="<%= box.key %>">
        <button type="submit" class="btn-ghost text-sm">
          <iconify-icon icon="boxicons:envelope" width="16" height="16" aria-hidden="true"></iconify-icon>
          <span>Mark unread</span>
        </button>
      </form>
      <% } %>
    </div>
    <h2 class="mt-2 text-xl font-semibold tracking-tight break-words"><%= thread.subject || '(no subject)' %></h2>
    <p class="mt-1 text-sm text-zinc-500">With <%= mail.formatAddress(thread.counterpart || {}) %> · <%= thread.mailbox || 'Other' %></p>

    <ol class="mt-5 space-y-4">
      <% messages.forEach((m) => { const out = m.direction === 'out'; %>
      <li class="overflow-hidden rounded-md border border-zinc-200 bg-surface <%= out ? 'border-l-4 border-l-cerise-300' : '' %>">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-zinc-100 px-4 py-3">
          <div class="min-w-0">
            <p class="break-words font-medium text-zinc-900"><%= who(m.from) %><% if (m.from?.name) { %> <span class="text-sm font-normal text-zinc-500">&lt;<%= m.from.address %>&gt;</span><% } %><% if (out) { %> <span class="ml-1 rounded-sm bg-cerise-50 px-1.5 py-0.5 text-xs font-medium text-cerise-700">Sent</span><% } %></p>
            <p class="break-words text-sm text-zinc-500">To <%= (m.to || []).join(', ') %><% if (m.cc?.length) { %> · Cc <%= m.cc.join(', ') %><% } %><% if (m.replyTo?.length) { %> · Reply to <%= m.replyTo.join(', ') %><% } %></p>
          </div>
          <time datetime="<%= new Date(m.date).toISOString() %>" class="shrink-0 text-sm text-zinc-500"><%= mail.fullDate(m.date) %></time>
        </div>
        <% if (mail.unverified(m)) { %>
        <p class="flex items-start gap-2 bg-red-50 px-4 py-2 text-sm text-red-800">
          <iconify-icon icon="boxicons:alert-shield" width="18" height="18" class="mt-px shrink-0" aria-hidden="true"></iconify-icon>
          <span>The sender’s address couldn’t be verified: this email may not be from who it says. Don’t follow its links or share anything private.</span>
        </p>
        <% } %>
        <div class="px-4 py-3">
          <% if (m.html) { %>
          <%# Whatever the sender wrote: no scripts, forms or access to this page (sandbox), only links, opened in a new tab %>
          <iframe sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer" loading="lazy" title="Email from <%= who(m.from) %>" srcdoc="<%= mail.frameDoc(m.html) %>" class="h-[28rem] w-full resize-y overflow-auto rounded-sm border border-zinc-200 bg-white"></iframe>
          <p class="mt-1 text-xs text-zinc-400">Images from other sites aren’t loaded.</p>
          <% } else { %>
          <div class="whitespace-pre-wrap break-words text-zinc-800"><%= m.text || '' %></div>
          <% } %>
          <% if (m.attachments?.length) { %>
          <ul class="mt-3 flex flex-wrap gap-2">
            <% m.attachments.forEach((a) => { %>
            <li>
              <a href="/admin/mail/messages/<%= m._id %>/attachments/<%= encodeURIComponent(a.id) %>" target="_blank" rel="noopener" class="inline-flex max-w-full items-center gap-2 rounded-md border border-zinc-200 px-3 py-1.5 text-sm text-zinc-700 hover:bg-zinc-50">
                <iconify-icon icon="boxicons:paperclip" width="16" height="16" aria-hidden="true"></iconify-icon>
                <span class="truncate"><%= a.filename || 'Attachment' %></span>
                <span class="shrink-0 text-zinc-400"><%= size(a.size) %></span>
              </a>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>
      </li>
      <% }) %>
    </ol>
  <% } else if (!compose) { %>
    <!-- A folder's threads, latest first -->
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-semibold"><%= box.label %><% if (box.address) { %> <span class="text-sm font-normal text-zinc-500"><%= box.address %></span><% } %></h2>
      <a href="<%= href(unreadOnly ? {} : { unread: '1' }) %>" class="text-sm font-medium text-cerise-600 hover:text-cerise-700 hover:underline"><%= unreadOnly ? 'Show all' : 'Unread only' %></a>
    </div>
    <% if (!list.threads.length) { %>
    <p class="mt-3 rounded-md border border-dashed border-zinc-200 px-4 py-10 text-center text-zinc-500"><%= unreadOnly ? 'Nothing unread here.' : 'No mail here yet.' %></p>
    <% } else { %>
    <ul class="mt-3 divide-y divide-zinc-100 overflow-hidden rounded-md border border-zinc-200 bg-surface">
      <% list.threads.forEach((t) => { const unread = t.unread > 0; %>
      <li>
        <a href="<%= href({ t: String(t._id) }) %>" class="flex gap-3 px-4 py-3 -outline-offset-2 hover:bg-zinc-50">
          <span class="mt-2 size-2 shrink-0 rounded-full <%= unread ? 'bg-brand' : '' %>" aria-hidden="true"></span>
          <span class="min-w-0 flex-1">
            <span class="flex items-baseline justify-between gap-3">
              <span class="truncate <%= unread ? 'font-semibold text-zinc-900' : 'text-zinc-700' %>">
                <% if (unread) { %><span class="sr-only">Unread: </span><% } %><%= who(t.counterpart) %><% if (t.messages > 1) { %> <span class="font-normal text-zinc-400"><%= t.messages %></span><% } %>
              </span>
              <time datetime="<%= new Date(t.lastAt).toISOString() %>" class="shrink-0 text-sm text-zinc-500"><%= mail.shortDate(t.lastAt) %></time>
            </span>
            <span class="block truncate <%= unread ? 'font-medium text-zinc-900' : 'text-zinc-700' %>"><%= t.subject || '(no subject)' %></span>
            <span class="block truncate text-sm text-zinc-500"><% if (box.key === 'all') { %><span class="font-medium text-zinc-600"><%= mailboxLabel(t.mailbox) %></span> · <% } %><% if (t.lastDirection === 'out') { %>You: <% } %><%= t.snippet %></span>
          </span>
        </a>
      </li>
      <% }) %>
    </ul>
    <% if (list.more) { %>
    <a href="<%= href({ ...(unreadOnly ? { unread: '1' } : {}), before: new Date(list.threads[list.threads.length - 1].lastAt).toISOString() }) %>" class="btn-ghost mt-3 border border-zinc-200 px-3 py-2 font-medium text-zinc-700">Older</a>
    <% } %>
    <% } %>
  <% } %>

  <% if (form) { %>
    <!-- A reply under the thread, or a new email. The key makes sending it twice send one email. -->
    <% if (compose) { %>
    <a href="/admin/mail?box=<%= box.key %>" class="btn-ghost -ml-2">
      <iconify-icon icon="boxicons:chevron-left" width="18" height="18" aria-hidden="true"></iconify-icon>
      <span><%= box.label %></span>
    </a>
    <% } %>
    <form id="mail-form" method="post" action="/admin/mail/send#mail-form" class="scroll-mt-6 <%= opened ? 'mt-6' : 'mt-2' %> space-y-3 rounded-md border border-zinc-200 bg-surface p-4">
      <h2 class="text-lg font-semibold"><%= opened ? 'Reply' : 'New email' %></h2>
      <% if (formError) { %>
      <p role="alert" class="rounded-md bg-red-50 px-3 py-2 text-base text-red-800"><%= formError %></p>
      <% } %>
      <input type="hidden" name="box" value="<%= box.key %>">
      <input type="hidden" name="key" value="<%= form.key %>">
      <% if (opened) { %>
      <input type="hidden" name="t" value="<%= opened.thread._id %>">
      <input type="hidden" name="answering" value="<%= form.answering %>">
      <% } %>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="label">From</span>
          <select name="from" class="field mt-1">
            <% mailboxes.forEach((m) => { %>
            <option value="<%= m.address %>" <% if (m.address === form.from) { %>selected<% } %>><%= m.name %> &lt;<%= m.address %>&gt;</option>
            <% }) %>
          </select>
        </label>
        <label class="block">
          <span class="label">To</span>
          <input type="text" name="to" value="<%= form.to || '' %>" required autocomplete="off" spellcheck="false" placeholder="name@example.com" class="field mt-1">
        </label>
      </div>
      <label class="block">
        <span class="label">Cc <span class="font-normal text-zinc-500">(optional)</span></span>
        <input type="text" name="cc" value="<%= form.cc || '' %>" autocomplete="off" spellcheck="false" placeholder="Separate addresses with commas" class="field mt-1">
      </label>
      <label class="block">
        <span class="label">Subject</span>
        <input type="text" name="subject" value="<%= form.subject || '' %>" required maxlength="300" class="field mt-1">
      </label>
      <label class="block">
        <span class="label">Message</span>
        <textarea name="body" rows="9" required maxlength="<%= bodyMax %>" class="field mt-1 resize-y"><%= form.body || '' %></textarea>
      </label>
      <% if (opened) { %>
      <p class="text-sm text-zinc-500">The email you’re answering is quoted under your message.</p>
      <% } %>
      <div class="flex justify-end">
        <button type="submit" class="btn-primary">
          <iconify-icon icon="boxicons:send" width="18" height="18" aria-hidden="true"></iconify-icon>
          <span>Send</span>
        </button>
      </div>
    </form>
  <% } %>
  </section>
</div>
<%- include('partials/foot') %>
