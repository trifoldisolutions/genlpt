<%- include('partials/head') %>
<%
  // The team's mailbox (routes/admin.js), in three columns that scroll on their own: the mailboxes; a mailbox's threads;
  // the thread open, or a form. Links and forms. On a tablet the mailboxes are a row above the other two; on a phone it's
  // one thing at a time, the list or the thread.
  const filterParams = { box: box.key, ...(q ? { q } : {}), ...(unreadOnly ? { unread: '1' } : {}) };
  const listParams = { ...filterParams, ...(before ? { before: before.toISOString() } : {}) };
  const href = (params = {}) => '/mail?' + new URLSearchParams({ ...listParams, ...params });
  const threadHref = (params = {}) => href({ t: String(opened.thread._id), ...params });
  const who = (a) => (a?.name ? a.name : a?.address) || 'Unknown sender';
  const initials = (a) => {
    const words = (a?.name || a?.address || '?').split('@')[0].split(/[\s._-]+/).filter(Boolean);
    return words.slice(0, 2).map((word) => [...word][0]).join('').toUpperCase() || '?';
  };
  const size = (n) => (n >= 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round((n || 0) / 1024))} KB`);
  const mailboxLabel = (address) => mail.BOXES.find((b) => b.address === address)?.label || 'Other';
  const ICONS = { all: 'inbox', support: 'headphone-mic', privacy: 'shield', alerts: 'bell', other: 'folder' };
  const reading = !!opened || !!compose;
  const openId = opened ? String(opened.thread._id) : null;
%>
<%# What the server has to say (sent, new mail, a failed check): toasts, like the app's (public/js/flash.js) %>
<% toasts.forEach((note) => { %>
<template data-flash="<%= note.kind %>"><%= note.text %></template>
<% }) %>

<div class="flex h-full flex-col md:grid md:grid-cols-[20rem_minmax(0,1fr)] md:grid-rows-[auto_minmax(0,1fr)] lg:grid-cols-[14rem_22rem_minmax(0,1fr)] lg:grid-rows-[minmax(0,1fr)]">

  <!-- The mailboxes: a row that scrolls sideways, a column from lg -->
  <aside class="<%= reading ? 'hidden md:flex' : 'flex' %> shrink-0 items-center gap-2 overflow-x-auto border-b border-zinc-200 bg-surface px-3 py-2 md:col-span-2 lg:col-span-1 lg:flex-col lg:items-stretch lg:overflow-x-visible lg:overflow-y-auto lg:border-r lg:border-b-0 lg:py-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <a href="<%= href({ compose: '1' }) %>" class="btn-primary shrink-0 py-2" title="New email">
      <iconify-icon icon="boxicons:edit" width="18" height="18" aria-hidden="true"></iconify-icon>
      <span class="sr-only lg:not-sr-only">New email</span>
    </a>
    <p class="mt-4 hidden px-2.5 text-sm text-zinc-500 lg:block">Mailboxes</p>
    <nav aria-label="Mailboxes" class="flex gap-1 lg:mt-1 lg:flex-col">
      <% boxes.forEach((b) => { %>
      <a href="/mail?box=<%= b.key %>" <% if (b.key === box.key) { %>aria-current="page"<% } %> class="flex shrink-0 items-center gap-2.5 rounded-md px-2.5 py-2 text-base text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900 aria-[current=page]:bg-zinc-100 aria-[current=page]:font-medium aria-[current=page]:text-zinc-900">
        <iconify-icon icon="boxicons:<%= ICONS[b.key] || 'envelope' %>" width="18" height="18" aria-hidden="true"></iconify-icon>
        <span class="lg:flex-1"><%= b.label %></span>
        <% if (counts[b.key]) { %><span class="rounded-full bg-brand px-1.5 text-xs font-semibold text-on-brand"><%= counts[b.key] %><span class="sr-only"> unread</span></span><% } %>
      </a>
      <% }) %>
    </nav>
  </aside>

  <!-- A mailbox's threads, latest first -->
  <section aria-label="<%= box.label %>" class="<%= reading ? 'hidden md:flex' : 'flex' %> min-h-0 flex-1 flex-col border-zinc-200 md:border-r">
    <div class="flex h-16 shrink-0 items-center justify-between gap-3 border-b border-zinc-200 bg-surface px-4">
      <div class="min-w-0">
        <h1 class="truncate text-xl font-semibold tracking-tight"><%= box.label %></h1>
        <% if (q) { %><p class="truncate text-sm text-zinc-500" title="Results for “<%= q %>”">Results for “<%= q %>”</p><% } else if (box.address) { %><p class="truncate text-sm text-zinc-500"><%= box.address %></p><% } %>
      </div>
      <a href="/mail?<%= new URLSearchParams({ box: box.key, ...(q ? { q } : {}), ...(unreadOnly ? {} : { unread: '1' }), ...(opened ? { t: openId } : {}) }) %>" class="shrink-0 text-sm font-medium text-cerise-600 hover:text-cerise-700 hover:underline"><%= unreadOnly ? 'Show all' : 'Unread only' %></a>
    </div>
    <div id="mail-list" data-place="<%= box.key %>|<%= q %>|<%= unreadOnly %>|<%= before ? before.toISOString() : '' %>" class="min-h-0 flex-1 overflow-y-auto [scrollbar-width:thin]">
      <% if (!list.threads.length && q) { %>
      <div class="px-4 py-10 text-center text-zinc-500">
        <p class="break-words">Nothing <%= unreadOnly ? 'unread ' : '' %>in <%= box.label %> matches “<%= q %>”.</p>
        <% if (box.key !== 'all') { %><a href="/mail?<%= new URLSearchParams({ box: 'all', q }) %>" class="mt-2 inline-block font-medium text-cerise-600 hover:text-cerise-700 hover:underline">Search all mail</a><% } %>
      </div>
      <% } else if (!list.threads.length) { %>
      <p class="px-4 py-10 text-center text-zinc-500"><%= unreadOnly ? 'Nothing unread here.' : 'No mail here yet.' %></p>
      <% } else { %>
      <ul class="divide-y divide-zinc-200">
        <% list.threads.forEach((t) => { const current = String(t._id) === openId; const unread = t.unread > 0 && !current; %>
        <li>
          <a href="<%= href({ t: String(t._id) }) %>" <% if (current) { %>aria-current="true"<% } %> class="flex gap-3 px-4 py-3 -outline-offset-2 hover:bg-zinc-100 aria-[current=true]:bg-zinc-200/70 <%= unread ? 'bg-surface' : '' %>">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-semibold <%= current ? 'bg-surface text-zinc-700' : 'bg-zinc-200/70 text-zinc-600' %>" aria-hidden="true"><%= initials(t.counterpart) %></span>
            <span class="min-w-0 flex-1">
              <span class="flex items-baseline justify-between gap-3">
                <span class="truncate <%= unread ? 'font-semibold text-zinc-900' : 'font-medium text-zinc-800' %>"><%= who(t.counterpart) %><% if (t.messages > 1) { %> <span class="font-normal text-zinc-500"><%= t.messages %></span><% } %></span>
                <time datetime="<%= new Date(t.lastAt).toISOString() %>" class="shrink-0 text-sm text-zinc-500"><%= mail.shortDate(t.lastAt) %></time>
              </span>
              <span class="flex items-center justify-between gap-3">
                <span class="truncate <%= unread ? 'font-medium text-zinc-900' : 'text-zinc-700' %>"><%= t.subject || '(no subject)' %></span>
                <% if (unread) { %><span class="shrink-0 rounded-sm bg-cerise-50 px-1.5 text-xs font-medium text-cerise-700">New</span><% } %>
              </span>
              <span class="block truncate text-sm text-zinc-500"><% if (box.key === 'all') { %><span class="font-medium text-zinc-600"><%= mailboxLabel(t.mailbox) %></span> · <% } %><% if (t.lastDirection === 'out') { %>You: <% } %><%= t.snippet %></span>
            </span>
          </a>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <% if (list.more || before) { %>
      <div class="flex gap-2 p-3">
        <% if (before) { %><a href="/mail?<%= new URLSearchParams(filterParams) %>" class="btn-ghost border border-zinc-200 px-3 py-2 font-medium text-zinc-700">Latest</a><% } %>
        <% if (list.more) { %><a href="<%= href({ before: new Date(list.threads[list.threads.length - 1].lastAt).toISOString() }) %>" class="btn-ghost border border-zinc-200 px-3 py-2 font-medium text-zinc-700">Older</a><% } %>
      </div>
      <% } %>
    </div>
  </section>

  <!-- The thread open, or a new email -->
  <section aria-label="<%= opened ? 'Email' : compose ? 'New email' : 'No email open' %>" class="<%= reading ? 'flex' : 'hidden md:flex' %> min-h-0 min-w-0 flex-1 flex-col bg-surface">
  <% if (reading) { %>
    <div class="flex h-14 shrink-0 items-center justify-between gap-2 border-b border-zinc-200 px-2 md:h-16 sm:px-4">
      <div class="flex min-w-0 items-center gap-1">
        <a href="<%= href() %>" class="icon-btn md:hidden" aria-label="Back to <%= box.label %>" title="Back to <%= box.label %>">
          <iconify-icon icon="boxicons:arrow-left" width="20" height="20" aria-hidden="true"></iconify-icon>
        </a>
        <% if (opened && opened.messages.some((m) => m.direction === 'in')) { %>
        <form method="post" action="/mail/threads/<%= openId %>/unread">
          <input type="hidden" name="box" value="<%= box.key %>">
          <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
          <button type="submit" class="btn-ghost">
            <iconify-icon icon="boxicons:envelope" width="18" height="18" aria-hidden="true"></iconify-icon>
            <span>Mark unread</span>
          </button>
        </form>
        <% } %>
      </div>
      <% if (opened) { %><span class="truncate text-sm text-zinc-500"><%= opened.thread.mailbox || 'Other' %></span><% } %>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto px-4 py-5 [scrollbar-width:thin] sm:px-6">
      <% if (opened) { const { thread, messages } = opened; const many = messages.length > 1; %>
      <h2 class="text-2xl font-semibold tracking-tight break-words"><%= thread.subject || '(no subject)' %></h2>
      <p class="mt-1 text-sm break-words text-zinc-500">With <%= mail.formatAddress(thread.counterpart || {}) %></p>

      <%# Oldest first. In a longer thread what's already read folds to one line; the latest, the new ones and those a search found stay open. %>
      <ol class="mt-4 divide-y divide-zinc-200 border-t border-zinc-200">
        <% messages.forEach((m, i) => {
          const out = m.direction === 'out';
          const wrap = many ? 'details' : 'div';
          const top = many ? 'summary' : 'div';
          const open = i === messages.length - 1 || (!out && m.read === false) || (many && mail.matchesSearch(m, q));
        %>
        <li>
          <<%= wrap %> class="group py-5" <% if (many && open) { %>open<% } %>>
            <<%= top %> class="flex items-start gap-3 <%= many ? 'list-none [&::-webkit-details-marker]:hidden' : '' %>">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-semibold <%= out ? 'bg-cerise-50 text-cerise-700' : 'bg-zinc-100 text-zinc-600' %>" aria-hidden="true"><%= initials(m.from) %></span>
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-baseline gap-x-2">
                  <span class="font-semibold break-words text-zinc-900"><%= who(m.from) %></span>
                  <% if (m.from?.name) { %><span class="text-sm break-all text-zinc-500"><%= m.from.address %></span><% } %>
                  <% if (out) { %><span class="rounded-sm bg-cerise-50 px-1.5 py-0.5 text-xs font-medium text-cerise-700">Sent</span><% } %>
                </span>
                <span class="<%= many ? 'hidden group-open:block' : 'block' %> text-sm break-words text-zinc-500">To <%= (m.to || []).join(', ') %><% if (m.cc?.length) { %> · Cc <%= m.cc.join(', ') %><% } %><% if (m.replyTo?.length) { %> · Reply to <%= m.replyTo.join(', ') %><% } %></span>
                <% if (many) { %><span class="block truncate text-sm text-zinc-500 group-open:hidden"><%= mail.snippetOf(m) %></span><% } %>
              </span>
              <span class="flex shrink-0 items-center gap-1">
                <time datetime="<%= new Date(m.date).toISOString() %>" class="text-sm text-zinc-500"><%= mail.fullDate(m.date) %></time>
                <% if (many) { %>
                <a href="<%= threadHref({ forward: String(m._id) }) %>" class="icon-btn -my-2 -mr-2" aria-label="Forward this email" title="Forward this email">
                  <iconify-icon icon="boxicons:forward" width="18" height="18" aria-hidden="true"></iconify-icon>
                </a>
                <% } %>
              </span>
            </<%= top %>>
            <% if (mail.unverified(m)) { %>
            <p class="mt-3 flex items-start gap-2 rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
              <iconify-icon icon="boxicons:alert-shield" width="18" height="18" class="mt-px shrink-0" aria-hidden="true"></iconify-icon>
              <span>The sender’s address couldn’t be verified: this email may not be from who it says. Don’t follow its links or share anything private.</span>
            </p>
            <% } %>
            <div class="mt-4">
              <% if (m.html) { %>
              <%# Whatever the sender wrote: no scripts, forms or access to this page (sandbox), only links, opened in a new tab %>
              <iframe sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer" loading="lazy" title="Email from <%= who(m.from) %>" srcdoc="<%= mail.frameDoc(m.html) %>" class="h-[60dvh] min-h-80 w-full resize-y overflow-auto rounded-sm border border-zinc-200 bg-white"></iframe>
              <p class="mt-1 text-xs text-zinc-500">Images from other sites aren’t loaded.</p>
              <% } else { %>
              <div class="whitespace-pre-wrap break-words text-zinc-800"><%= m.text || '' %></div>
              <% } %>
            </div>
            <% if (m.attachments?.length) { %>
            <h3 class="mt-5 font-semibold text-zinc-900">Attachments</h3>
            <ul class="mt-2 flex flex-wrap gap-2">
              <% m.attachments.forEach((a) => { const tile = 'flex w-52 max-w-full items-center gap-2.5 rounded-md border border-zinc-200 p-2'; %>
              <li class="max-w-full">
                <% if (out) { %><div class="<%= tile %>"><% } else { %><a href="/mail/messages/<%= m._id %>/attachments/<%= encodeURIComponent(a.id) %>" target="_blank" rel="noopener" class="<%= tile %> hover:bg-zinc-50"><% } %>
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-sm bg-zinc-100 text-zinc-600" aria-hidden="true">
                    <iconify-icon icon="boxicons:<%= (a.contentType || '').startsWith('image/') ? 'image' : 'file-detail' %>" width="18" height="18"></iconify-icon>
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-medium text-zinc-800"><%= a.filename || 'Attachment' %></span>
                    <span class="block text-xs text-zinc-500"><%= size(a.size) %></span>
                  </span>
                <% if (out) { %></div><% } else { %></a><% } %>
              </li>
              <% }) %>
            </ul>
            <% } %>
          </<%= wrap %>>
        </li>
        <% }) %>
      </ol>
      <% } %>

      <% if (form) { const replying = opened && !forwarding; %>
      <!-- A reply under the thread, a forward, or a new email. The key makes sending it twice send one email. -->
      <form id="mail-form" method="post" action="/mail/send#mail-form" data-busy class="scroll-mt-4 space-y-3 <%= opened ? 'rounded-md border border-zinc-200 p-4' : '' %>">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-lg font-semibold"><%= forwarding ? 'Forward' : replying ? 'Reply' : 'New email' %></h2>
          <a href="<%= opened ? threadHref() : href() %>" class="icon-btn -my-1.5 -mr-2" aria-label="Discard" title="Discard">
            <iconify-icon icon="boxicons:x" width="20" height="20" aria-hidden="true"></iconify-icon>
          </a>
        </div>
        <% if (formError) { %>
        <p role="alert" class="rounded-md bg-red-50 px-3 py-2 text-base text-red-800"><%= formError %></p>
        <% } %>
        <input type="hidden" name="box" value="<%= box.key %>">
        <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
        <input type="hidden" name="key" value="<%= form.key %>">
        <% if (opened) { %>
        <input type="hidden" name="t" value="<%= openId %>">
        <% if (forwarding) { %>
        <input type="hidden" name="forwarding" value="<%= form.forwarding %>">
        <% } else { %>
        <input type="hidden" name="answering" value="<%= form.answering %>">
        <% } %>
        <% } %>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block">
            <span class="label">From</span>
            <select name="from" class="field mt-1">
              <% mailboxes.forEach((m) => { %>
              <option value="<%= m.address %>" <% if (m.address === form.from) { %>selected<% } %>><%= m.name %> &lt;<%= m.address %>&gt;</option>
              <% }) %>
            </select>
          </label>
          <label class="block">
            <span class="label">To</span>
            <input type="text" name="to" value="<%= form.to || '' %>" required <% if (!replying && !formError) { %>autofocus<% } %> autocomplete="off" spellcheck="false" placeholder="name@example.com" class="field mt-1">
          </label>
        </div>
        <label class="block">
          <span class="label">Cc <span class="font-normal text-zinc-500">(optional)</span></span>
          <input type="text" name="cc" value="<%= form.cc || '' %>" autocomplete="off" spellcheck="false" placeholder="Separate addresses with commas" class="field mt-1">
        </label>
        <label class="block">
          <span class="label">Subject</span>
          <input type="text" name="subject" value="<%= form.subject || '' %>" required maxlength="300" class="field mt-1">
        </label>
        <label class="block">
          <span class="label">Message<% if (forwarding) { %> <span class="font-normal text-zinc-500">(optional)</span><% } %></span>
          <textarea name="body" rows="<%= opened ? 6 : 12 %>" <% if (!forwarding) { %>required<% } %> <% if (replying && !formError) { %>autofocus<% } %> maxlength="<%= bodyMax %>" class="field mt-1 resize-y"><%= form.body || '' %></textarea>
        </label>
        <% if (forwarding?.attachments?.some((a) => a.id)) { %>
        <fieldset>
          <legend class="label">Attachments to send along</legend>
          <div class="mt-1 space-y-1">
            <% forwarding.attachments.filter((a) => a.id).forEach((a) => { %>
            <label class="flex cursor-pointer items-center gap-2 text-base text-zinc-700">
              <input type="checkbox" name="attachments" value="<%= a.id %>" <% if ((form.attachments || []).includes(a.id)) { %>checked<% } %> class="size-4 shrink-0 accent-brand">
              <span class="truncate"><%= a.filename || 'Attachment' %></span>
              <span class="shrink-0 text-sm text-zinc-500"><%= size(a.size) %></span>
            </label>
            <% }) %>
          </div>
        </fieldset>
        <% } %>
        <% if (opened) { %>
        <p class="text-sm text-zinc-500"><%= forwarding ? 'The email you’re forwarding goes under your message, as plain text.' : 'The email you’re answering is quoted under your message.' %></p>
        <% } %>
        <div class="flex justify-end">
          <button type="submit" class="btn-primary">
            <iconify-icon icon="boxicons:send" width="18" height="18" aria-hidden="true"></iconify-icon>
            <span>Send</span>
          </button>
        </div>
      </form>
      <% } %>
    </div>

    <% if (opened && !form && opened.messages.length) { %>
    <div class="flex shrink-0 gap-2 border-t border-zinc-200 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-6">
      <a href="<%= threadHref({ reply: '1' }) %>" class="btn-ghost border border-zinc-200 px-3 py-2 font-medium text-zinc-700">
        <iconify-icon icon="boxicons:reply" width="18" height="18" aria-hidden="true"></iconify-icon>
        <span>Reply</span>
      </a>
      <a href="<%= threadHref({ forward: String(opened.messages.at(-1)._id) }) %>" class="btn-ghost border border-zinc-200 px-3 py-2 font-medium text-zinc-700">
        <iconify-icon icon="boxicons:forward" width="18" height="18" aria-hidden="true"></iconify-icon>
        <span>Forward</span>
      </a>
    </div>
    <% } %>
  <% } else { %>
    <div class="flex flex-1 flex-col items-center justify-center gap-2 px-6 text-center text-zinc-500">
      <iconify-icon icon="boxicons:envelope-open" width="32" height="32" class="text-zinc-400" aria-hidden="true"></iconify-icon>
      <p>Choose an email to read it here.</p>
    </div>
  <% } %>
  </section>
</div>
<%- include('partials/foot') %>
