<%- include('../partials/head') %>
<%# The privacy policy and terms (routes/public.js): this layout, with the document in views/public/legal/<doc>.<lang>.ejs %>
<article class="legal mx-auto max-w-2xl">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm text-zinc-500">
    <span><%= lang === 'fr' ? 'Dernière mise à jour :' : 'Last updated:' %> <%= updated %></span>
    <a href="<%= other.href %>" hreflang="<%= other.lang %>" lang="<%= other.lang %>" class="inline-flex items-center gap-1.5 font-medium text-zinc-600 hover:text-zinc-900">
      <iconify-icon icon="boxicons:globe" width="16" height="16" aria-hidden="true"></iconify-icon>
      <span><%= other.lang === 'fr' ? 'Version française' : 'English version' %></span>
    </a>
  </div>
  <h1 class="mt-4 text-3xl font-bold tracking-tight"><%= title %></h1>
  <%- include(`legal/${doc}.${lang}.ejs`) %>
</article>
<%- include('../partials/foot') %>
