<% const isApp = locals.shell === 'app'; const bare = isApp || locals.shell === 'auth'; %>
<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= locals.title ? `${title} · ${appName}` : `${appName} – ${brand.tagline}` %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=SUSE:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/output.css">
  <script src="/js/theme.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@2/dist/iconify-icon.min.js"></script>
</head>
<body class="<%= isApp ? 'h-dvh overflow-hidden' : 'min-h-dvh' %> bg-zinc-50 font-sans text-zinc-900 antialiased" data-app-name="<%= appName %>" data-answer-min="<%= limits.ANSWER_MIN_CHARS %>" data-answer-max="<%= limits.ANSWER_MAX_CHARS %>" data-expand-depth="<%= limits.EXPAND_DEPTH %>"data-guest-hours="<%= limits.GUEST_HOURS %>" data-usage-hours="<%= limits.USAGE_WINDOW_HOURS %>">
<% if (!bare) { %>
  <header class="border-b border-zinc-200 bg-surface">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
      <a href="/" class="font-bold tracking-tight"><%= appName %></a>
      <div class="flex gap-4 text-sm text-zinc-600">
        <a href="/about" class="hover:text-zinc-900">About</a>
        <a href="/app" class="hover:text-zinc-900">App</a>
      </div>
    </nav>
  </header>
  <main class="mx-auto max-w-5xl px-4 py-10">
<% } %>
