<% if (!['app', 'auth'].includes(locals.shell)) { const l = locals.lang === 'fr' ? 'fr' : 'en'; %>
  </main>
  <footer class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-6 text-xs text-zinc-400">
    <span>&copy; <%= new Date().getFullYear() %> <%= appName %></span>
    <% ['privacy', 'terms'].forEach((doc) => { %>
    <a href="<%= legal.PATHS[doc][l] %>" class="text-zinc-500 hover:text-zinc-900"><%= legal.TITLES[doc][l] %></a>
    <% }) %>
  </footer>
<% } %>
</body>
</html>
